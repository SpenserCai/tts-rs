{
  "name": "@spensercai/tts-rs",
  "version": "0.1.0",
  "description": "Modular native speech synthesis and voice conditioning with Rust and Candle",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "files": ["index.js", "index.d.ts", "*.node", "README.md"],
  "engines": { "node": ">=22" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpenserCai/tts-rs.git",
    "directory": "bindings/node"
  },
  "napi": {
    "binaryName": "tts-rs",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --js index.js --dts index.d.ts",
    "test": "node --test tests/smoke.cjs",
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dirs"
  },
  "devDependencies": { "@napi-rs/cli": "^3.0.0" }
}
